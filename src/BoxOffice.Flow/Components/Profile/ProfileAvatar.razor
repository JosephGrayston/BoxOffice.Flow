@inherits BoxOffice.Flow.Components.Common.CancellableComponent

@if (UserProfile is not null)
{
    <MudAvatar Color="Color.Primary">
        @if (AvatarUrl is not null)
        {
            <MudImage src="@AvatarUrl" alt="User Avatar" />
        }
        else
        {
            @UserProfile.Initials
        }
    </MudAvatar>
}
