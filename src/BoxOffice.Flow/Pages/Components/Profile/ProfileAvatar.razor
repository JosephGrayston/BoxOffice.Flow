@inherits BoxOffice.Flow.Pages.Components.Common.CancellableComponent

@if (UserState.UserProfile is not null)
{
    <MudAvatar Color="Color.Primary">
        @if (AvatarUrl is not null)
        {
            <MudImage src="@AvatarUrl" alt="User Avatar" />
        }
        else
        {
            @UserState.UserProfile?.Initials
        }
    </MudAvatar>
}
