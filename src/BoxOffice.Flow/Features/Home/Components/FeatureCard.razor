<MudPaper Elevation="0" Class="pa-6" Style="border: 1px solid var(--mud-palette-divider); border-radius:12px; min-height: 180px;">
    <MudStack Spacing="3" Style="height: 100%;">
        <MudIcon Icon="@Icon" Size="Size.Large" Color="@Colour" />
        <MudText Typo="Typo.h6" Style="font-weight:700;">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Description
        </MudText>
    </MudStack>
</MudPaper>
